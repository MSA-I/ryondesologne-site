---
// Story and area page template (DESIGN §12 "Story and area pages"): Base + the pond (or aerial) field under brume at 60svh,
// the H1 in Imbue lower-left, an optional lead and one sharp print right, then chapters (default slot) and closing parts (slot "end").
import "../styles/kit.css";
import Base from "./Base.astro";
import Print from "../components/kit/Print.astro";
import { img } from "../lib/assets";
interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  h1: string;
  /** assets.json id of a `blurred: true` *-field row */
  fieldId: string;
  /** sharp print right of the H1 (first screen: eager, high priority) */
  print?: { id: string; box: number };
}
const { title, description, canonicalPath, h1, fieldId, print } = Astro.props;
const field = img(fieldId, { box: 640, sizes: "100vw", loading: "eager", fetchpriority: "high", blurred: true });
---
<Base title={title} description={description} canonicalPath={canonicalPath} current={canonicalPath}>
  <section class:list={["histo", print && "histo--print"]} style={print ? `--histo-print:${print.box}px` : undefined} data-site-studio-component="story-opening">
    <figure class="histo-champ" aria-hidden="true">
      <picture>
        {field.sources.map((s) => <source type={s.type} srcset={s.srcset} sizes="100vw" />)}
        <img src={field.src} width={field.width} height={field.height} alt="" loading="eager" fetchpriority="high" decoding="async" />
      </picture>
      <span class="histo-brume"></span>
    </figure>
    <div class="histo-texte">
      <h1 class="histo-titre">{h1}</h1>
      <div class="histo-lead"><slot name="lead" /></div>
    </div>
    {print && <Print id={print.id} box={print.box} sizes={`(max-width: 760px) 100vw, ${print.box}px`} loading="eager" fetchpriority="high" class="histo-print" />}
  </section>
  <slot />
  <slot name="end" />
</Base>

<style is:global>
  .histo {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 60vh; min-height: 60svh;
    display: grid; grid-template-columns: minmax(0, 1fr); align-items: end; column-gap: var(--gap-columns);
    padding: var(--space-6) var(--pad) var(--space-5);
    color: var(--encre);
  }
  .histo--print { grid-template-columns: minmax(0, 1fr) minmax(0, min(var(--histo-print), 40vw)); }
  .histo-champ { position: absolute; inset: 0; z-index: -1; margin: 0; overflow: hidden; background: var(--brume); }
  .histo-champ picture { display: contents; }
  .histo-champ img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    filter: blur(var(--blur-field)) saturate(1.3); transform: scale(1.22);
  }
  .histo-brume { position: absolute; inset: 0; background: var(--brume); opacity: var(--brume-opacity); }
  .histo-texte { display: flex; flex-direction: column; gap: var(--space-3); }
  .histo-titre {
    margin: 0; max-width: 11em;
    font-family: var(--font-display); font-weight: var(--fw-display);
    font-size: var(--fs-display-2); line-height: var(--lh-display-2); letter-spacing: var(--tr-display);
    text-wrap: balance;
  }
  .histo-lead { max-width: var(--measure-note); font-size: var(--fs-lead); line-height: var(--lh-lead); }
  .histo-lead:empty { display: none; }
  .histo-lead p { margin: 0; }
  .histo-print { width: 100%; align-self: end; }

  @media (max-width: 760px) {
    .histo { min-height: 0; grid-template-columns: minmax(0, 1fr); row-gap: var(--space-4); padding: var(--space-6) var(--pad) var(--space-4); }
    .histo-titre { font-size: var(--fs-display-phone); max-width: none; }
    .histo-lead { font-size: var(--fs-lead-phone); }
    .histo-champ img { filter: blur(var(--blur-field-phone)) saturate(1.2); transform: scale(1.1); }
    .histo-brume { opacity: var(--brume-opacity-phone); }
  }
</style>
