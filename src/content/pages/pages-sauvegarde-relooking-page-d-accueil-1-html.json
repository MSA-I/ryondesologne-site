    },
    {
      "n": 27,
      "tag": "p",
      "text": "(atelier pédagogique, DIY, pétanque, détente, sportif, ferme pédagogique...)"
    },
    {
      "n": 28,
      "tag": "p",
      "text": "Dévouvrez notre projet étape par étape"
    },
