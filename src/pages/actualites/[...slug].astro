---
// News article (DESIGN §12 News): brume-crème reading page, H1 Imbue, date and author line --fs-meta, body --fs-reading in --measure,
// images as prints within their max_css_width (reveal only on the large ones), a door to the offer it speaks of (cuisine/menus ->
// Restaurant / Traiteur, wedding posts -> Réservations Mariage, others none) and the cta2 back to the list (UX-25).
// Text: the article's blocks, between its date (first time) and "Partager"; navigation, share widget, footer and the attribute
// blocks are listed in 06-build/omitted/T35.json. Link targets and the place of each image come from the old page's HTML
// (01-scan/raw/<id>.html): the blocks carry neither.
import { getCollection } from "astro:content";
import { readFileSync, existsSync } from "node:fs";
import { dirname, join, resolve } from "node:path";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/kit/Breadcrumbs.astro";
import Print from "../../components/kit/Print.astro";
import Cta2 from "../../components/kit/Cta2.astro";
import Door from "../../components/kit/Door.astro";
import { t, blocks } from "../../lib/content";
import MenuText from "../../components/MenuText.astro";
import { asset, img } from "../../lib/assets";
import { menusFor, menuOfAsset, menuId } from "../../lib/menus";
import { plain, excerpt } from "../../lib/seo";
import { ft, NAV } from "../../lib/site";

// /actualites/<slug>.html and /actualites/<category>/<slug>.html: the slug is the path without ".html" (build.format "preserve" writes <slug>.html).
export async function getStaticPaths() {
  const news = await getCollection("news");
  return news.map((e) => ({
    params: { slug: new URL(e.data.url).pathname.replace(/^\/actualites\//, "").replace(/\.html$/, "") },
    props: { id: e.id },
  }));
}
const { id } = Astro.props as { id: string };
const D = (await getCollection("news")).find((e) => e.id === id)!.data;
const path = new URL(D.url).pathname;

function findSite(): string {
  let d = resolve(process.cwd());
  for (let i = 0; i < 6; i++) {
    if (existsSync(join(d, "05-assets", "assets.json"))) return d;
    d = dirname(d);
  }
  throw new Error("actualites/[...slug]: 05-assets/assets.json not found above " + process.cwd());
}
const raw = readFileSync(join(findSite(), "01-scan", "raw", `${id}.html`), "utf8");
// Old <title> and meta description, verbatim; the approved rewrites arrive with T38.
const title = raw.match(/<title>([^<]*)<\/title>/)?.[1]?.trim() || D.title;
const rawDescription = raw.match(/<meta name="description" content="([^"]*)"/)?.[1]?.trim() || D.title;

// ---- the article's blocks -------------------------------------------------------------------------------------------
const iDate = D.blocks.findIndex((b) => b.tag === "time");
const iEnd = D.blocks.findIndex((b) => b.tag === "span" && b.text === "Partager");
if (iDate < 0 || iEnd < 0) throw new Error(`news ${id}: no date or share block`);
const by = D.blocks.find((b) => b.tag === "span" && b.text === "Par");
if (!by) throw new Error(`news ${id}: no "Par" block`);
const rest = blocks(id, D.blocks[iDate].n + 1, D.blocks[iEnd].n - 1);
const updated = rest.filter((b) => b.tag === "time").map((b) => b.text);
let cat: { word: string; label: string; href: string } | undefined;
const body: { tag: string; text: string }[] = [];
for (let i = 0; i < rest.length; i++) {
  const b = rest[i];
  if (b.tag === "time") continue;
  if ((b.tag === "p" || b.tag === "div") && b.text === "Dans" && rest[i + 1]?.tag === "a") {
    cat = { word: b.text, label: rest[i + 1].text, href: `/actualites/${D.category}/` };
    i++;
    continue;
  }
  body.push({ tag: b.tag, text: b.text });
}

// Meta description: the old excerpt (BaseHead decodes it, caps it at 160 characters, approved metas win). When it only repeats the
// title, it is built from the first body block that differs from the title (verbatim client text).
const foldTitle = (s: string) => plain(s).normalize("NFD").replace(/[^p{L}p{N}]/gu, "").toLowerCase();
const sameAsTitle = foldTitle(rawDescription) === foldTitle(title);
const firstOther = body.find((b) => b.tag !== "a" && foldTitle(b.text) && foldTitle(b.text) !== foldTitle(title) && foldTitle(b.text) !== foldTitle(D.title) && !/[<>]/.test(b.text));
const description = sameAsTitle && firstOther ? excerpt(firstOther.text, 160) : rawDescription;

// ---- the old page's HTML: link targets, bold-only paragraphs, place of the images ----------------------------------------
const decode = (s: string) =>
  s
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&quot;/g, '"')
    .replace(/&#0?39;|&apos;/g, "'")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&#(\d+);/g, (_, n) => String.fromCharCode(Number(n)));
const strip = (h: string) => decode(h.replace(/<[^>]+>/g, " "));
const fold = (s: string) => s.normalize("NFD").replace(/[^\p{L}\p{N}]/gu, "").toLowerCase();
const stem = (s: string) => decodeURIComponent(s.split("?")[0].split("/").pop() ?? "").replace(/\.[a-z0-9]+$/i, "").toLowerCase();

const start = raw.indexOf('class="content"');
// the text lives in "content" and in the page-builder rows that follow it, up to the share plugin
const stop = [raw.indexOf("plugin-list", start), raw.indexOf("<script", start)].filter((x) => x > 0);
const content = start < 0 ? "" : raw.slice(raw.indexOf(">", start) + 1, Math.min(...stop, raw.length));

const anchors: { text: string; href: string }[] = [];
for (const m of content.matchAll(/<a\b([^>]*)>([\s\S]*?)<\/a>/g)) {
  const href = m[1].match(/href="([^"]*)"/)?.[1];
  const text = strip(m[2]).replace(/\s+/g, " ").trim();
  if (href && text) anchors.push({ text, href: decode(href) });
}
const headings = new Set<string>(); // paragraphs wholly bold in the old page
for (const m of content.matchAll(/<(p|h[2-4])\b[^>]*>([\s\S]*?)<\/\1>/g)) {
  const text = strip(m[2]).replace(/\s+/g, " ").trim();
  const rest2 = m[2].replace(/<(strong|b)\b[^>]*>[\s\S]*?<\/\1>/gi, "").replace(/<[^>]+>/g, "").replace(/&nbsp;|\s/g, "");
  if (text && (m[1] !== "p" || rest2 === "") && text.length <= 90) headings.add(fold(text) + (m[1] === "p" ? ":p" : ":h"));
}

const local = (href: string) => {
  try {
    const u = new URL(href, "https://www.rayondesologne.fr");
    if (/^(www\.)?rayondesologne\.fr$/.test(u.hostname) && /^https?:$/.test(u.protocol)) return u.pathname + u.search + u.hash;
    return href;
  } catch {
    return href;
  }
};

// nodes: p / h / ul / pdf, each with the first and last body index it holds
type Link = { text: string; href?: string };
type Node =
  | { kind: "p"; text: string; bold: boolean; links: Link[]; first: number; last: number }
  | { kind: "h"; text: string; first: number; last: number }
  | { kind: "ul"; items: { text: string; links: Link[] }[]; first: number; last: number }
  | { kind: "pdf"; link: Link; first: number; last: number };
const nodes: Node[] = [];
let ap = 0; // read pointer in the anchors of the old page
for (let i = 0; i < body.length; i++) {
  const b = body[i];
  if (b.tag === "a") {
    let href: string | undefined;
    for (let j = ap; j < anchors.length; j++) {
      if (fold(anchors[j].text) === fold(b.text)) { href = local(anchors[j].href); ap = j + 1; break; }
    }
    // a broken target (raw markup or whitespace, e.g. an iframe tag pasted into the href) is dropped: the text shows without a link
    if (href && /[<>"\s]/.test(href)) href = undefined;
    const link: Link = { text: b.text, href };
    const prev = nodes[nodes.length - 1];
    if (href && /\.pdf(\?|$)/i.test(href)) nodes.push({ kind: "pdf", link, first: i, last: i });
    else if (prev?.kind === "p") { prev.links.push(link); prev.last = i; }
    else if (prev?.kind === "ul") { prev.items[prev.items.length - 1].links.push(link); prev.last = i; }
    else nodes.push({ kind: "p", text: "", bold: false, links: [link], first: i, last: i });
  } else if (b.tag === "li") {
    const prev = nodes[nodes.length - 1];
    if (prev?.kind === "ul") { prev.items.push({ text: b.text, links: [] }); prev.last = i; }
    else nodes.push({ kind: "ul", items: [{ text: b.text, links: [] }], first: i, last: i });
  } else if (headings.has(fold(b.text) + ":h")) {
    nodes.push({ kind: "h", text: b.text, first: i, last: i });
  } else {
    nodes.push({ kind: "p", text: b.text, bold: headings.has(fold(b.text) + ":p"), links: [], first: i, last: i });
  }
}

// images: raw order, each after the body block it follows
const wanted = D.images.map((imgId) => {
  const a = asset(imgId);
  return { id: imgId, stems: [a.derived_from, a.original_file].filter(Boolean).map((x) => stem(String(x))), max: a.max_css_width ?? 640 };
});
const placed = new Map<number, typeof wanted>(); // body index (-1 = before the text) -> images
const used = new Set<string>();
for (const m of content.matchAll(/<img\b[^>]*>/g)) {
  const src = decode(m[0].match(/src="([^"]*)"/)?.[1] ?? "");
  const hit = wanted.find((w) => !used.has(w.id) && w.stems.includes(stem(src)));
  if (!hit) continue;
  used.add(hit.id);
  const before = fold(strip(content.slice(0, m.index)));
  let cursor = 0, k = -1;
  body.forEach((b, i) => {
    const f = fold(b.text);
    if (!f) return;
    const j = before.indexOf(f, cursor);
    if (j >= 0) { cursor = j + f.length; k = i; }
  });
  placed.set(k, [...(placed.get(k) ?? []), hit]);
}
const unplaced = wanted.filter((w) => !used.has(w.id));
if (unplaced.length) placed.set(-1, [...(placed.get(-1) ?? []), ...unplaced]);
// an image after block k goes after the node holding k (never inside a list)
const after = (n: Node) => [...placed.entries()].filter(([k]) => k >= n.first && k <= n.last).flatMap(([, v]) => v);
const lead = placed.get(-1) ?? [];
// the first content image of the article (document order): on a phone the title fills the first screen and the image lies below it,
// so it stays lazy like the others (eager + high priority took the line from the display face and the stylesheet); it is still never revealed
const firstImageId = (lead[0] ?? nodes.flatMap((n) => after(n))[0])?.id;
// large prints open with the reveal effect; the first image sits on the first screen, never revealed
const BOX = 640;
const printOf = (w: (typeof wanted)[number]) => ({ id: w.id, box: Math.min(w.max, BOX) });
const big = (box: number) => box >= 600;
// verbatim menu transcriptions (03-copy/menus-transcribed.json): each shown beside the image it transcribes (below it on small screens);
// that image is drawn here (not by Print) so it can carry aria-describedby -> the text block
const menus = menusFor(path);
const menuOf = (w: (typeof wanted)[number]) => menuOfAsset(menus, asset(w.id));
const pic = (w: (typeof wanted)[number]) => {
  const box = printOf(w).box;
  return img(w.id, { box, sizes: `(max-width: 760px) 100vw, ${box}px` });
};
const shown = new Set(wanted.map((w) => menuOf(w)).filter(Boolean));
const orphans = menus.filter((m) => !shown.has(m)); // a transcription whose image is not on the page: text after the body

// ---- door to the offer ---------------------------------------------------------------------------------------------------
// the closing door print is cover-cropped into a square (.art-porte): its image is drawn box-high and (box x aspect) wide, so sizes follow the drawn width, at 2x for a sharp print
const doorSizes = (printId: string) => { const d = img(printId, { box: 248, sizes: "" }); return `${Math.ceil(248 * Math.max(1, d.width / d.height) * 2)}px`; };
const T = D.title.toLowerCase();
const offer: "restaurant" | "mariage" | undefined =
  D.category === "blog" ? "mariage"
  : D.category === "cuisine" ? "restaurant"
  : D.category === "actualites"
    ? /mariage/.test(T) ? "mariage"
    : /menu|bistrot|soir[ée]e|brunch|formule|fermeture|ducasse|jeu concours|no[ëe]l|tradition|stop arr|partants|journée en famille/.test(T) ? "restaurant"
    : undefined
  : undefined;
const RESTO = "pages-le-restaurant-html";
const MARIAGE = "pages-salle-de-mariage-et-reception-html";
const door =
  offer === "restaurant"
    ? { label: NAV[1].label, href: NAV[1].href, line: t(RESTO, 6), printId: "28c71597-b1bc-46c8-92a7-2f185bc7f681-496x496", light: { use: "restaurant" as const, photoId: "28c71597-b1bc-46c8-92a7-2f185bc7f681-field" } }
    : offer === "mariage"
      ? { label: NAV[3].label, href: NAV[3].href, line: t(MARIAGE, 8), printId: "mariage-boheme-rayon-de-sologne-photos-mariage", light: { use: "gites" as const, photoId: "mariage-11-field" } }
      : undefined;

// ---- breadcrumbs ----------------------------------------------------------------------------------------------------------
const index = t("actualites", 6);
const crumbs = [
  { label: t("actualites", 1), href: "/" },
  { label: index, href: "/actualites/" },
  ...(cat && cat.label !== index ? [{ label: cat.label, href: cat.href }] : []),
  { label: D.title },
];
---
<Base title={title} description={description} canonicalPath={path} current="/actualites/">
  <article class="art" data-site-studio-component="news-article">
    <div class="art-wrap">
      <Breadcrumbs items={crumbs} />
      <header class="art-head">
        <h1 class="art-titre">{D.title}</h1>
        <p class="art-meta">
          <time datetime={D.isoDate}>{D.date}</time>
          <span>{by.text} {D.author}</span>
          {updated.map((u) => <span>{u}</span>)}
          {cat && <span>{cat.word} <a href={cat.href}>{cat.label}</a></span>}
        </p>
      </header>
      <div class="art-corps">
        {lead.map((w) => menuOf(w) ? (
          <div class="art-menu" style={`--b:${printOf(w).box}px`}>
            <div class="art-fig"><picture class="print">{pic(w).sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={`(max-width: 760px) 100vw, ${printOf(w).box}px`} />)}<img src={pic(w).src} width={pic(w).width} height={pic(w).height} alt={pic(w).alt} loading="lazy" decoding="async" aria-describedby={menuId(menuOf(w)!)} /></picture></div>
            <MenuText menu={menuOf(w)!} />
          </div>
        ) : <div class="art-fig" style={`--b:${printOf(w).box}px`}><Print id={printOf(w).id} box={printOf(w).box} sizes={`(max-width: 760px) 100vw, ${printOf(w).box}px`}  /></div>)}
        {nodes.flatMap((n) => [
          n.kind === "h" || (n.kind === "p" && n.bold && n.text && !n.links.length) ? <h2 class="art-h">{n.text}</h2>
          : n.kind === "pdf" ? <p class="art-pdf"><Cta2 href={n.link.href!} label={n.link.text} icon="file" /></p>
          : n.kind === "ul" ? (
            <ul>{n.items.map((it) => <li>{it.text}{it.links.map((l) => <Fragment>{" "}{l.href ? <a href={l.href} target={/^https?:\/\//.test(l.href) ? "_blank" : undefined} rel={/^https?:\/\//.test(l.href) ? "noopener" : undefined}>{l.text}</a> : l.text}</Fragment>)}</li>)}</ul>
          ) : (
            <p>{n.bold ? <strong>{n.text}</strong> : n.text}{n.links.map((l) => <Fragment>{n.text ? " " : ""}{l.href ? <a href={l.href} target={/^https?:\/\//.test(l.href) ? "_blank" : undefined} rel={/^https?:\/\//.test(l.href) ? "noopener" : undefined}>{l.text}{/^https?:\/\//.test(l.href) && <span class="visually-hidden"> {ft("link.newtab-hint")}</span>}</a> : l.text}</Fragment>)}</p>
          ),
          ...after(n).map((w) => menuOf(w) ? (
            <div class="art-menu" style={`--b:${printOf(w).box}px`}>
              <div class="art-fig"><picture class="print" data-effect={w.id !== firstImageId && big(printOf(w).box) ? "reveal" : undefined}>{pic(w).sources.map((s) => <source type={s.type} srcset={s.srcset} sizes={`(max-width: 760px) 100vw, ${printOf(w).box}px`} />)}<img src={pic(w).src} width={pic(w).width} height={pic(w).height} alt={pic(w).alt} loading="lazy" decoding="async" aria-describedby={menuId(menuOf(w)!)} /></picture></div>
              <MenuText menu={menuOf(w)!} />
            </div>
          ) : <div class="art-fig" style={`--b:${printOf(w).box}px`}><Print id={printOf(w).id} box={printOf(w).box} sizes={`(max-width: 760px) 100vw, ${printOf(w).box}px`} effect={w.id !== firstImageId && big(printOf(w).box) ? "reveal" : undefined}  /></div>),
        ])}
        {orphans.map((m) => <div class="art-menu art-menu--seul"><MenuText menu={m} /></div>)}
        <p class="art-retour"><Cta2 href="/actualites/" label={ft("news.back")} /></p>
      </div>
    </div>
  </article>
  {door && (
    <Door
      title={door.label}
      titleId="porte-offre-titre"
      line={door.line}
      href={door.href}
      linkLabel={door.label}
      printId={door.printId}
      box={248}
      sizes={doorSizes(door.printId)}
      light={door.light}
      class="art-porte"
    />
  )}
</Base>

<style is:global>
  .art { background: var(--brume-creme); color: var(--encre); padding: var(--space-6) var(--pad) var(--space-5); }
  .art-wrap { max-width: calc(var(--measure) * 1.4); margin-inline: auto; }
  .art-head { margin: var(--space-3) 0 var(--space-4); }
  .art-titre {
    margin: 0 0 var(--space-3);
    font-family: var(--font-display); font-weight: var(--fw-display);
    font-size: var(--fs-display-2); line-height: var(--lh-display-2); letter-spacing: var(--tr-display);
    text-wrap: balance; overflow-wrap: anywhere;
  }
  .art-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 var(--space-3); margin: 0; font-size: var(--fs-meta); line-height: var(--lh-small); }
  .art-meta a { display: inline-flex; align-items: center; min-height: var(--tap-min); text-decoration: underline; text-underline-offset: var(--underline-offset); }
  .art-corps { max-width: var(--measure); }
  .art-corps p, .art-corps li { font-size: var(--fs-reading); line-height: var(--lh-reading); overflow-wrap: anywhere; }
  .art-corps p { margin: 0 0 var(--space-3); }
  .art-corps ul { margin: 0 0 var(--space-3); padding-inline-start: var(--space-3); }
  .art-corps li { margin: 0 0 var(--space-1); }
  .art-corps a { text-decoration: underline; text-underline-offset: var(--underline-offset); touch-action: manipulation; }
  .art-h { margin: var(--space-4) 0 var(--space-2); font-weight: var(--fw-h2-text); font-size: var(--fs-h2-text); line-height: var(--lh-h2-text); text-wrap: balance; }
  .art-fig { width: min(100%, var(--b)); margin: var(--space-3) 0 var(--space-4); }
  .art-fig img { width: 100%; }
  /* a menu image and its transcription: stacked on small screens, image left and text right from 1181 px (in the reading width of the page) */
  .art-menu { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 var(--space-4); align-items: start; margin: var(--space-3) 0 var(--space-4); }
  .art-menu .art-fig { margin: 0 0 var(--space-3); }
  .art-menu .print { display: block; }
  .art-menu .print img { display: block; max-width: 100%; height: auto; border-radius: var(--radius-print); }
  @media (min-width: 1181px) {
    .art-menu { width: calc(var(--measure) * 1.4); grid-template-columns: minmax(0, var(--b)) minmax(0, 1fr); }
    .art-menu .art-fig { margin: 0; }
    .art-menu--seul { grid-template-columns: minmax(0, 1fr); }
  }
  .art-pdf { margin: 0 0 var(--space-3); }
  /* the closing door follows the article: title and print on one row, the line and the link beside the print (capped near its content) */
  .door.art-porte { min-height: 0; padding: var(--space-4) var(--pad); gap: var(--space-3); }
  .door.art-porte .door-print img { aspect-ratio: 1; }
  @media (min-width: 1181px) {
    .door.art-porte { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: var(--space-5); }
    .door.art-porte .door-body { align-items: center; }
  }
  .art-retour { margin: var(--space-4) 0 0; }
  @media (max-width: 760px) {
    .art { padding-top: var(--space-6); }
    .art-titre { font-size: var(--fs-display-phone); }
    .art-meta { font-size: var(--fs-meta-phone); }
    .art-corps p, .art-corps li { font-size: var(--fs-body-phone); }
  }
</style>
