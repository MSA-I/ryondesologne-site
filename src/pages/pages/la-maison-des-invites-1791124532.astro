---
// Les hirondelles (DESIGN §12 lodging page). The old page is a copy of La maison des invités: it keeps only the scanned text,
// verbatim (blocks 6-22); the lodging's own text is a client question and sits as a placeholder in the first chapter.
// Blocks 1-5 and 23-142 (nav, planner markup, share widget, footer, attributes) are listed in 06-build/omitted/T29.json.
import LodgingPage from "../../layouts/LodgingPage.astro";
import Chapter from "../../components/Chapter.astro";
import Cta2 from "../../components/kit/Cta2.astro";
import { t, fact, factTel } from "../../lib/content";
import { showPlaceholders } from "../../lib/site";

const P = "pages-la-maison-des-invites-1791124532-html";
const PAGE = "/pages/la-maison-des-invites-1791124532.html";
const RES = "pages-reservations-html";
const GITES = "pages-nos-gites-html";
// p7-fix-v5 item 5: the old HTML was `gite<span>s</span>` (rendered "gites"); the scan inserted a space. Joined at render, wording otherwise verbatim.
const gitesLabel = (s: string) => s.replace(/gite s(?=\s|$)/, "gites");

// Old <title> verbatim (01-scan/raw). The old page has no meta description: its first paragraph stands in.
const title = "Les hirondelles";
const description = t(P, 8);

// Capacity stat cut from block 10: "4 chambres".
const cap = t(P, 10).match(/^(\d+) (chambres)/);
if (!cap) throw new Error("hirondelles: capacity phrase not found in block 10");

// Old link destinations (hrefs are not in the block text; 01-scan/raw/pages-la-maison-des-invites-1791124532-html.html).
const PDF_PRESENTATION = "/medias/files/hirondelle-gite-rayon-de-sologne-compressed.pdf";
const PDF_TRAITEUR = "/medias/files/plaquette-traiteur-gite-rayon-de-sologne-avec-compression.pdf";
const PDF_OPTIONS = "/medias/files/option-gite-rayon-de-sologne-compresse.pdf";
const legend = [20, 21, 22].map((n) => t(P, n)).join(" ");
---
<LodgingPage
  title={title}
  description={description}
  canonicalPath={PAGE}
  pageId={P}
  h1={t(P, 6)}
  light="gites"
  printId="vue-aerienne-rayon-de-sologne-par-onesebphoto-1120x840"
  printBox={512}
  capacity={{ figure: cap[1], words: cap[2] }}
  phone={{ label: fact("phone-domaine"), tel: factTel("phone-domaine") }}
  plannerTitle={t(P, 19)}
  planner={{ page: "pages-la-maison-des-invites-1791124532", key: "OSMB-123001-8", legend }}
  parent={{ label: gitesLabel(t(GITES, 6)), href: "/pages/nos-gites.html" }}
  booking={{ href: "#disponibilites", label: t(RES, 104) }}
  crumbs={[{ label: t(P, 1), href: "/" }, { label: gitesLabel(t(GITES, 6)), href: "/pages/nos-gites.html" }, { label: t(P, 6) }]}
>
  <Chapter tone="creme" title={t(P, 7)} titleId="hirondelles-gite">
    {showPlaceholders && <p lang="he">[דרוש תוכן: texte propre aux Hirondelles]</p>}
    <p>{t(P, 8)}</p>
    <p>{t(P, 9)}</p>
    <ul class="lodging-liste">
      {[10, 11, 12, 13, 14].map((n) => <li>{t(P, n)}</li>)}
    </ul>
  </Chapter>

  <Chapter tone="light" light={{ use: "gites", photoId: "mariage-11-field" }}>
    <p>{t(P, 15)}</p>
    <Cta2 href={PDF_PRESENTATION} label={t(P, 16)} icon="file" newTab />
    <Cta2 href={PDF_TRAITEUR} label={t(P, 17)} icon="file" newTab />
    <Cta2 href={PDF_OPTIONS} label={t(P, 18)} icon="file" newTab />
  </Chapter>
</LodgingPage>
