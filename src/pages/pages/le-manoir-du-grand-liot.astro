---
// Le manoir (DESIGN §12 lodging page). Text from pages-le-manoir-du-grand-liot-html (blocks cited), no typed copy.
// Blocks 6-39 (7 = the lead, first paragraph of chapter 1) are used (6 = the old H2 promoted to the H1; 36 = planner heading, 37-39 = planner legend); 1-5, 40-168 (nav, calendar markup, share widget,
// footer, attributes) are listed in 06-build/omitted/T28.json.
import LodgingPage from "../../layouts/LodgingPage.astro";
import Chapter from "../../components/Chapter.astro";
import Cta2 from "../../components/kit/Cta2.astro";
import Print from "../../components/kit/Print.astro";
import { t, fact, factTel } from "../../lib/content";

const P = "pages-le-manoir-du-grand-liot-html";
const PAGE = "/pages/le-manoir-du-grand-liot.html";
const RES = "pages-reservations-html";

// Old <title> and meta description, verbatim (01-scan/raw).
const title = "Gite 38 personnes en sologne avec salle / le manoir";
const description =
  "Le manoir, gite de groupe en sologne près de romorantin, 9 chambres, salle jusqu'à 60 personnes, cuisine équipée et parc privatif.";

// Destinations of the old links (hrefs are not in the block text; 01-scan/raw/pages-le-manoir-du-grand-liot-html.html).
const VISIT = "https://my.matterport.com/show/?m=gFXW73G3tSp&play=1&lang=fr&hl=2&brand=0&title=0&vr=0&ss=143&sr=-.08,.39";
const PDF_MANOIR = "/medias/files/manoir-rayon-de-sologne-infos-hebergement.pdf-compressed.pdf";
const PDF_TRAITEUR = "/medias/files/plaquette-traiteur-gite-rayon-de-sologne-avec-compression.pdf";
const PDF_OPTIONS = "/medias/files/option-gite-rayon-de-sologne-compresse.pdf";

// Opening stat, cut from the client's own sentence (block 6).
const guests = t(P, 6).match(/(\d+) (personnes)/);
if (!guests) throw new Error("manoir: capacity phrase not found in block 6");

const light = { use: "gites" as const, photoId: "mariage-11-field" };
const margin = (id: string) => ({ id, box: 248 });
// a chapter holds one marginPrint prop; further produced manoir prints (old page photos) go in its margin slot, same box
---
<LodgingPage
  title={title}
  description={description}
  canonicalPath={PAGE}
  pageId={P}
  h1={t(P, 6)}
  light="gites"
  printId="manoir-grand-liot-rayon-de-sologne-1-1120x840"
  printBox={512}
  capacity={{ figure: guests[1], words: guests[2] }}
  phone={{ label: fact("phone-domaine"), tel: factTel("phone-domaine") }}
  planner={{ page: "pages-le-manoir-du-grand-liot", key: "OSMB-123001-1", legend: [37, 38, 39].map((n) => t(P, n)).join(" ") }}
  plannerTitle={t(P, 36)}
  parent={{ label: t(P, 3), href: "/pages/reservations.html" }}
  booking={{ href: "/pages/reservations.html#reserver", label: t(RES, 104) }}
  crumbs={[{ label: t(P, 1), href: "/" }, { label: t(P, 6) }]}
>
  <Chapter tone="creme" title={t(P, 8)} titleId="manoir-cousinades" marginPrint={margin("rayondesolognephotochambremanoir41")}>
    <p>{t(P, 7)}</p>
    <p>{t(P, 9)}</p>
    <p>{t(P, 10)}</p>
    <Print slot="quote" id="terrasse-gite-xxl-manoir-rayon-de-sologne-720x540" box={248} sizes="248px" effect="reveal" class="chap-print" />
  </Chapter>

  <Chapter tone="light" light={light} title={t(P, 11)} titleId="manoir-salle" marginPrint={margin("dsc-7218")}>
    <p>{t(P, 12)}</p>
    <Cta2 href={VISIT} label={t(P, 13)} newTab />
  </Chapter>

  <Chapter tone="creme" title={t(P, 14)} titleId="manoir-chambres" marginPrint={margin("salle-de-bain-attenante-a-la-chambre-nuptiale-dans-le-manoir-rayon-de-sologne41320")}>
    <p>{t(P, 15)}</p>
    <ul class="lodging-liste">
      {[16, 17, 18].map((n) => <li>{t(P, n)}</li>)}
    </ul>
    <p>{t(P, 19)}</p>
    <ul class="lodging-liste">
      {[20, 21, 22, 23].map((n) => <li>{t(P, n)}</li>)}
    </ul>
  </Chapter>

  <Chapter tone="light" light={light} title={t(P, 24)} titleId="manoir-cuisine" marginPrint={margin("coinsalondanslamanoirchezrayondesologne41320")}>
    <p>{t(P, 25)}</p>
    <Cta2 href={PDF_MANOIR} label={t(P, 26)} icon="file" />
    <p>{t(P, 27)}</p>
    <Cta2 href={PDF_TRAITEUR} label={t(P, 28)} icon="file" />
    <Print slot="quote" id="espacebibliothequedanslemanoirchezrayondesologne41320-720x540" box={248} sizes="248px" effect="reveal" class="chap-print" />
  </Chapter>

  <Chapter tone="creme" marginPrint={margin("cour-manoir-rayon-de-sologne-41320")}>
    <Print slot="quote" id="cour-du-manoir-rayon-de-sologne-960x720" box={248} sizes="248px" effect="reveal" class="chap-print" />
    <p>{t(P, 29)}</p>
    <p>{t(P, 30)}</p>
    <ul class="lodging-liste">
      {[31, 32, 33].map((n) => <li>{t(P, n)}</li>)}
    </ul>
  </Chapter>

  <Chapter tone="light" light={light} title={t(P, 34)} titleId="manoir-avant">
    <Cta2 href={PDF_OPTIONS} label={t(P, 35)} icon="file" />
  </Chapter>
</LodgingPage>
